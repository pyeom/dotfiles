{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["tray"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio#microphone", "pulseaudio", "custom/notifications"],

    "clock": {
        "format": "{:%d/%m - %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "network": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "",
        "format-disconnected": "󰞃",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "alacritty -e nmtui"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-bluetooth": " {volume}%",
        "interval": 1,
        "format-icons": {
            "muted": "󰖁",
            "bluetooth": "",
            "headphones": " ",
            "default": ""
        },
        "scroll-step": 1,
        "on-scroll-up": "~/.config/waybar/scripts/actions/volumecontrol.sh output up",
        "on-scroll-down": "~/.config/waybar/scripts/actions/volumecontrol.sh output down",
        "on-click": "~/.config/waybar/scripts/audio-output-selector.sh",
        "tooltip-format": "{icon} {desc} | {volume}%",
        "on-click-right": "~/.config/waybar/scripts/actions/volumecontrol.sh output toggle"
    },

    "pulseaudio#microphone": {
        "format": "{format_source} {source_volume}%",
        "rotate": 0,
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "~/.config/waybar/scripts/audio-input-selector.sh",
        "on-click-right": "~/.config/waybar/scripts/actions/volumecontrol.sh input toggle",
        "on-scroll-up": "~/.config/waybar/scripts/actions/volumecontrol.sh input up",
        "on-scroll-down": "~/.config/waybar/scripts/actions/volumecontrol.sh input down",
        "tooltip-format": "{format_source} {source_desc} | {source_volume}%",
        "scroll-step": 1
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/notifications": {
        "format": "󰂚 {count}",
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    }
}
