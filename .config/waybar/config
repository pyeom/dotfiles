{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["tray"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth", "network", "pulseaudio#microphone", "pulseaudio", "custom/notifications", "battery"],

    "clock": {
        "format": "{:%d/%m - %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "rotate": 0,
        "format-connected-battery": "{icon}",
        "format-icons": [
            "󰤾",
            "󰤿",
            "󰥀",
            "󰥁",
            "󰥃",
            "󰥅",
            "󰥈",
            "󰥇"
        ],
        "tooltip-format": "{icon} {device_alias} | {device_battery_percentage}%",
        "tooltip-format-enumerate-connected": "{device_enumerate} {num_connections}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_battery_percentage}%",
        "on-click": "blueman-manager",
        "interval": 1
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰞃",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "alacritty -e nmtui"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-bluetooth": " {volume}%",
        "interval": 1,
        "format-icons": {
            "muted": "󰖁",
            "bluetooth": "",
            "headphones": " ",
            "default": ""
        },
        "scroll-step": 1,
        "on-scroll-up": "~/.config/waybar/scripts/actions/volumecontrol.sh output up",
        "on-scroll-down": "~/.config/waybar/scripts/actions/volumecontrol.sh output down",
        "on-click": "~/.config/waybar/scripts/audio-output-selector.sh",
        "tooltip-format": "{icon} {desc} | {volume}%",
        "on-click-right": "~/.config/waybar/scripts/actions/volumecontrol.sh output toggle"
    },

    "pulseaudio#microphone": {
        "format": "{format_source} {source_volume}%",
        "rotate": 0,
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "~/.config/waybar/scripts/audio-input-selector.sh",
        "on-click-right": "~/.config/waybar/scripts/actions/volumecontrol.sh input toggle",
        "on-scroll-up": "~/.config/waybar/scripts/actions/volumecontrol.sh input up",
        "on-scroll-down": "~/.config/waybar/scripts/actions/volumecontrol.sh input down",
        "tooltip-format": "{format_source} {source_desc} | {source_volume}%",
        "scroll-step": 1
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂜",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂜"
        },
        "on-click": "swaync-client -t -sw",
        "escape": true,
        "tooltip": false
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "rotate": 0,
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
