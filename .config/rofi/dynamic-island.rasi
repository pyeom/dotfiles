/*
 * Dynamic Island Theme for Rofi
 * A pill-shaped, centered launcher inspired by macOS Dynamic Island
 */

/* Load pywal colors */
@theme "~/.cache/wal/colors-rofi-dark.rasi"

* {
    border-width: 0px;
    background-color: transparent;
    text-color: @foreground;
}

/* ---- Configuration ---- */
configuration {
    modi: "drun,run";
    font: "JetBrains Mono Nerd Font 11";
    show-icons: true;
    icon-theme: "kora";
    display-drun: "";
    display-run: "";
    display-filebrowser: "";
    display-window: "";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    drun-display-format: "{name}";
    scroll-method: 0;
}

/* ---- Window ---- */
window {
    width: 600px;
    transparency: "real";
    location: north;
    anchor: north;
    fullscreen: false;
    enabled: true;
    border-radius: 30px;
    cursor: "default";
    background-color: @background;
    border: 2px solid;
    border-color: rgba(255, 255, 255, 0.15);
    x-offset: 0px;
    y-offset: 80px;
    padding: 0px;
    margin: 0px;
}

/* ---- Mainbox ---- */
mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 0px;
    margin: 0px;
    padding: 20px;
    background-color: transparent;
    children: ["inputbar", "listview"];
}

/* ---- Inputbar ---- */
inputbar {
    enabled: true;
    spacing: 15px;
    padding: 15px 20px;
    border-radius: 25px;
    background-color: rgba(255, 255, 255, 0.05);
    text-color: @foreground;
    children: ["textbox-prompt-colon", "entry"];
    margin: 0px 0px 15px 0px;
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: "󰀻";
    padding: 0px;
    background-color: transparent;
    text-color: inherit;
    font: "JetBrains Mono Nerd Font 14";
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: inherit;
    cursor: text;
    placeholder: "Search...";
    placeholder-color: rgba(255, 255, 255, 0.3);
}

/* ---- Listview ---- */
listview {
    enabled: true;
    columns: 1;
    lines: 6;
    cycle: false;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 5px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}

/* ---- Element ---- */
element {
    enabled: true;
    padding: 12px 15px;
    margin: 0px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 20px;
    spacing: 15px;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: rgba(255, 255, 255, 0.1);
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/* ---- Message ---- */
message {
    background-color: transparent;
    padding: 10px;
}

textbox {
    padding: 15px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

error-message {
    padding: 15px;
    border-radius: 20px;
    background-color: rgba(255, 100, 100, 0.1);
    text-color: @foreground;
}
